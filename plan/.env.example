# --- Payload ---
PAYLOAD_SECRET=genera-una-cadena-larga-y-random-aqui

# --- Postgres (Railway te da esta variable automáticamente al agregar el plugin de Postgres) ---
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# --- Cloudflare R2 ---
R2_BUCKET=ark-wiki-images
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key

# --- Opcional: si conectas un dominio público para servir las imágenes ---
# R2_PUBLIC_URL=https://media.tudominio.com
